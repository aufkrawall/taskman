# Generic local debug/developer tool path overrides for TaskMan.
# Copy or merge into tool-paths.env and customize for the local machine/project.
# Do not commit tool-paths.env or machine-specific paths to git.

# Repository/artifact roots
PROJECT_ROOT=
BUILD_ROOT=
INSTALL_ROOT=
SYMBOL_ROOT=
LOG_ROOT=
DUMP_ROOT=
CAPTURE_ROOT=

# Windows SDK Debugging Tools architecture roots.
# Each value should point at the corresponding Debuggers\<arch> directory.
WINDOWS_SDK_DEBUGGERS_X86=
WINDOWS_SDK_DEBUGGERS_X64=
WINDOWS_SDK_DEBUGGERS_ARM=
WINDOWS_SDK_DEBUGGERS_ARM64=

# MSVC binary-tool directories or roots containing dumpbin/link/lib/editbin/undname.
MSVC_TOOLS_X86=
MSVC_TOOLS_X64=
MSVC_TOOLS_ARM64=

# Other developer/debug tool roots
SYSINTERNALS_ROOT=
LLVM_ROOT=
FFMPEG_ROOT=

# TaskMan isolation and runtime test overrides (optional)
# TASKMAN_DATA_DIR=
# TASKMAN_CONFIG_DIR=
# TASKMAN_RENDERER=wgpu|glow|software
# TASKMAN_GPU=auto|compatibility|software
# TASKMAN_FPS_PROBE=1
# TASKMAN_DIALOG=settings|run|end_task
# TASKMAN_PERF=cpu|mem|disk|net|gpu

# Notes:
# - Paths may be absolute or relative to PROJECT_ROOT.
# - tools/discover-debug-tools.ps1 reads the architecture/tool-root variables above.
# - Explicit overrides are checked before standard Windows locations and PATH.
# - Missing optional tools are recorded in debug-tool-manifest.json; discovery itself is non-mutating.
