# makepkg scratch space: the Arch PKGBUILD builds from this checkout, so its
# src/ and pkg/ directories and the package it writes appear next to it (see
# packaging/arch/PKGBUILD)
packaging/arch/src/
packaging/arch/pkg/
packaging/arch/*.pkg.tar.*

